[Unit]
Description=Unwall API
After=network.target

[Service]
Type=simple
User=unwall
WorkingDirectory=/srv/api.unwall.app
ExecStart=/usr/bin/node --max-old-space-size=6144 /srv/api.unwall.app/backend/index.js
Restart=on-failure
Environment="NODE_ENV=production"
Environment="PORT=3001"
Environment="UNWALL_MODEM_EGRESS=fallback"
Environment="UNWALL_MODEM_LOCAL_ADDR=192.168.8.100"
Environment="UNWALL_MODEM_PROXY=socks5://127.0.0.1:1081"

[Install]
WantedBy=multi-user.target
