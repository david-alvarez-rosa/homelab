auto lo
iface lo inet loopback
allow-hotplug enp3s0f1
iface enp3s0f1 inet dhcp
iface enp3s0f1 inet6 auto

allow-hotplug lte-digi
iface lte-digi inet static
    address 192.168.8.100/24
    post-up /usr/local/sbin/modem-routing $IFACE 100
    pre-down ip rule del from 192.168.8.100 table 100 priority 100

allow-hotplug lte-lowi
iface lte-lowi inet static
    address 192.168.9.100/24
    post-up /usr/local/sbin/modem-routing $IFACE 101
    pre-down ip rule del from 192.168.9.100 table 101 priority 101
