#!/bin/sh
set -e
IF="$1"
TABLE="$2"
SRC=$(ip -4 -o addr show dev "$IF" | awk '{print $4}' | cut -d/ -f1)
NET=${SRC%.*}
ip route replace "$NET.0/24" dev "$IF" src "$SRC" table "$TABLE"
ip route replace default via "$NET.1" dev "$IF" table "$TABLE"
ip rule del from "$SRC" table "$TABLE" priority "$TABLE" 2>/dev/null || true
ip rule add from "$SRC" table "$TABLE" priority "$TABLE"
sysctl -qw net.ipv4.conf."$IF".rp_filter=2
