#!/bin/sh
set -e
FORCE=
[ "$1" = "-f" ] && { FORCE=1; shift; }
IF=${1:-lte-digi}
SRC=$(ip -4 -o addr show dev "$IF" | awk '{print $4}' | cut -d/ -f1)
GW=${SRC%.*}.1
C=$(mktemp)
trap 'rm -f "$C"' EXIT

D=$(basename "$(dirname "$(readlink -f "/sys/class/net/$IF/device")")")

tok() {
    curl -s -c "$C" --max-time 8 "http://$GW/api/webserver/SesTokInfo" \
        | tr -d "\n" | sed -e "s/.*<TokInfo>//" -e "s|</TokInfo>.*||"
}

api() {
    curl -s -b "$C" --max-time 8 -H "__RequestVerificationToken: $(tok)" "http://$GW/api/$1" | tr -d "\n"
}

field() {
    sed -e "s/.*<$1>//" -e "s|</$1>.*||"
}

replug() {
    [ -e "/sys/bus/usb/devices/$D/authorized" ] || { echo "no usb device for $IF" >&2; exit 1; }
    echo 0 > "/sys/bus/usb/devices/$D/authorized"
    sleep 6
    echo 1 > "/sys/bus/usb/devices/$D/authorized"
    n=0
    while [ $n -lt 20 ]; do
        sleep 3
        ip link show "$IF" >/dev/null 2>&1 && break
        n=$((n + 1))
    done
    sleep 25
}

if [ -z "$FORCE" ] && ping -c1 -W3 -I "$IF" "$GW" >/dev/null 2>&1; then
    echo "modem responsive, use -f to reset anyway"
else
    replug
    ping -c1 -W3 -I "$IF" "$GW" >/dev/null 2>&1 || { echo "modem still unreachable" >&2; exit 1; }
fi

echo "wan:    $(api device/information | field WanIPAddress)"
echo "status: $(api monitoring/status | field ConnectionStatus)"
echo "egress: $(curl -s --max-time 20 --interface "$IF" https://ifconfig.me/ip)"
