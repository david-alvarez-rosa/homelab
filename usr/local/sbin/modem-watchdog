#!/bin/sh
IF="$1"
SRC=$(ip -4 -o addr show dev "$IF" | awk '{print $4}' | cut -d/ -f1)
STAMP=/run/modem-watchdog.$IF.last
COOLDOWN=600

for t in 1.1.1.1 8.8.8.8 9.9.9.9; do
    ping -c3 -W3 -I "$SRC" "$t" >/dev/null 2>&1 && exit 0
done

now=$(date +%s)
last=$(cat "$STAMP" 2>/dev/null || echo 0)
if [ $((now - last)) -lt $COOLDOWN ]; then
    echo "lte egress down on $IF, reset skipped (cooldown)"
    exit 0
fi
echo "$now" > "$STAMP"
echo "lte egress down on $IF, resetting modem"
/usr/local/sbin/modem-reset -f "$IF"
